 MAX_BYTES = 1_000_000
 MAX_TASKS = 10_000
+MAX_TAGS = 20
+
+
+def normalize_tag(tag):
+    if not isinstance(tag, str):
+        raise ValueError("tags must be strings")
+    tag = tag.strip().lower()
+    if not 1 <= len(tag) <= 40:
+        raise ValueError("tags must contain 1–40 characters")
+    return tag
+
+
+def normalize_tags(tags):
+    result = sorted({normalize_tag(tag) for tag in tags})
+    if len(result) > MAX_TAGS:
+        raise ValueError("tasks may have at most 20 distinct tags")
+    return result
 
 
